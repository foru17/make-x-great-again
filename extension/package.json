{
  "name": "mxga-extension",
  "version": "0.5.0",
  "private": true,
  "description": "Make X Great Again (MXGA) — passive ambient X browser extension (WXT, MV3).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "prebuild:safari": "node ../scripts/prepare-safari-list.js",
    "build:safari": "wxt build -b safari --mv3",
    "postbuild:safari": "node ../scripts/prepare-safari-list.js --clean",
    "xcode:safari": "../scripts/build-safari-app.sh",
    "xcode:safari:ios": "../scripts/build-safari-ios-app.sh",
    "build:firefox": "wxt build -b firefox",
    "build:firefox-android": "wxt build -b firefox",
    "lint:firefox-android": "tsx scripts/lint-firefox-android.ts",
    "run:firefox-android": "npm exec --yes --package=web-ext@10.6.0 -- web-ext run --target firefox-android --source-dir .output/firefox-mv3",
    "zip": "wxt zip",
    "prezip:safari": "node ../scripts/prepare-safari-list.js",
    "zip:safari": "wxt zip -b safari --mv3",
    "postzip:safari": "node ../scripts/prepare-safari-list.js --clean",
    "zip:firefox": "wxt zip -b firefox",
    "test": "tsx --test test/**/*.test.ts",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "shell-quote": "^1.10.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
