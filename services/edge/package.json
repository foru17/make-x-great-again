{
  "name": "x-spam-sentinel-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker — public API + D1 curation store for x-spam-sentinel.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "vite",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:css && npm run build:app",
    "build:css": "node scripts/build-css.mjs",
    "build:app": "vite build",
    "db:init": "wrangler d1 execute xss-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute xss-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "types:check": "wrangler types worker-configuration.d.ts --check",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:runtime": "node scripts/smoke-worker.mjs"
  },
  "dependencies": {
    "hono": "^4.12.29",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
